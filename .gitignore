# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment files and secrets
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
!.env.example
!frontend/.env.example
!backend/.env.example
!frontend/.env.production

# Generated frontend output
dist/
frontend/dist/
build/
coverage/

# Runtime databases, migration backups, and uploads
backend/data/*.json
backend/data/*.bak
backend/data/*.tmp
backend/data/mongo-backups/
backend/data/mysql-backups/
backend/uploads/*
!backend/uploads/.gitkeep
*.db
**/chroma_db/

# Package-manager caches
.npm-cache/
.npm/
.yarn/
.pnpm-store/

# Logs and process files
*.log
*.err
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo

# Editor and operating-system files
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Test and tool caches
.eslintcache
.cache/
.vite/
.nyc_output/
.pytest_cache/
**/.pytest_cache/
**/.ruff_cache/

# Python / chatbot generated files
.venv/
venv/
**/.venv*/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
**/*.py[cod]

# Flutter generated files
**/.dart_tool/
**/.pub-cache/
**/.flutter-plugins-dependencies
