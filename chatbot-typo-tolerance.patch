+import re
+from difflib import get_close_matches
+from typing import Iterable
+
+
+# Common Somali spellings and phone-keyboard shorthand. These canonical forms
+# improve intent detection; answers still come only from the indexed dataset.
+ALIASES = {
+    "xage": "xagee",
+    "xagey": "xagee",
+    "halke": "halkee",
+    "side": "sidee",
+    "sidn": "sideen",
+    "tla": "taalaa",
+    "tala": "taalaa",
+    "talaa": "taalaa",
+    "jamacada": "jaamacadda",
+    "jamacadda": "jaamacadda",
+    "jamacada": "jaamacadda",
+    "jamhuriya": "jamhuriya",
+    "diwan": "diiwaan",
+    "diwaan": "diiwaan",
+    "diiwan": "diiwaan",
+    "isdiiwan": "isdiiwaan",
+    "isdiwan": "isdiiwaan",
+    "galiya": "geliyaa",
+    "galiyaa": "geliyaa",
+    "gelia": "geliyaa",
+    "dokument": "dukumenti",
+    "document": "dukumenti",
+    "lacg": "lacag",
+    "lacgta": "lacagta",
+    "kuliyad": "kulliyad",
+    "kulyad": "kulliyad",
+    "caafimad": "caafimaad",
+    "scholership": "scholarship",
+    "requirment": "requirement",
+    "admision": "admission",
+    "addmission": "admission",
+    "registrtion": "registration",
+    "universty": "university",
+}
+
+DOMAIN_VOCABULARY = {
+    "admission", "application", "apply", "campus", "certificate",
+    "computer", "department", "diiwaan", "diiwaangelin", "documents",
+    "engineering", "faculty", "fees", "graduation", "halkee", "hostel",
+    "jaamacadda", "jamhuriya", "kulliyad", "lacag", "medicine", "nursing",
+    "program", "register", "registration", "requirement", "scholarship",
+    "student", "taalaa", "university", "xagee",
+}
+
+
+def normalize_query(text: str, extra_vocabulary: Iterable[str] = ()) -> str:
+    normalized = text.lower().strip().replace("â€™", "'")
+    normalized = re.sub(r"[^a-z0-9\s'$]", " ", normalized)
+    tokens = re.sub(r"\s+", " ", normalized).strip().split()
+    vocabulary = DOMAIN_VOCABULARY | {
+        word.lower() for word in extra_vocabulary if len(word) >= 3
+    }
+
+    corrected: list[str] = []
+    for token in tokens:
+        direct = ALIASES.get(token)
+        if direct:
+            corrected.append(direct)
+            continue
+        if token in vocabulary or len(token) < 3:
+            corrected.append(token)
+            continue
+
+        cutoff = 0.68 if len(token) <= 4 else 0.76
+        match = get_close_matches(token, vocabulary, n=1, cutoff=cutoff)
+        corrected.append(match[0] if match else token)
+
+    result = " ".join(corrected)
+    phrase_aliases = {
+        "is diiwaan": "isdiiwaan",
+        "isku diiwaan geliyaa": "sidee la isku diiwaangeliyaa" if result.startswith("sidee") else "isku diiwaangeliyaa",
+        "diiwaan geliyaa": "diiwaangeliyaa",
+    }
+    for source, target in phrase_aliases.items():
+        result = result.replace(source, target)
+    return result
