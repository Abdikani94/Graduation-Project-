PORT=5055
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5180,http://127.0.0.1:5180
JWT_SECRET=your_jwt_secret_here
TOKEN_EXPIRES_IN_SECONDS=86400
MAX_BODY_BYTES=15728640
DB_DRIVER=mysql
# XAMPP MySQL/MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jamhuriya_admission
MYSQL_CONNECTION_LIMIT=10
WAAFI_ENV=sandbox
WAAFI_SANDBOX_URL=https://sandbox.waafipay.com/asm
WAAFI_PRODUCTION_URL=https://api.waafipay.net/asm
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=
WAAFI_PAYMENT_METHOD=mwallet_account
WAAFI_CURRENCY=USD
WAAFI_MERCHANT_DISPLAY_NAME=Online Registration System
WAAFI_MERCHANT_NAME=Online Registration System
WAAFI_MERCHANT_PHONE=
WAAFI_MINIMUM_AMOUNT=0.01
# No maximum payment limit is enforced by this application.
WAAFI_MAXIMUM_AMOUNT=0
WAAFI_REQUEST_TIMEOUT_MS=120000
WAAFI_PHONE_ENCRYPTION_KEY=replace_with_a_long_random_secret
# Centralized file storage (10 MB default)
MAX_STORED_FILE_BYTES=10485760
FILE_STORAGE_DIR=./uploads/centralized-files
# Admission registration scheduler interval (milliseconds)
ADMISSION_PERIOD_SCHEDULER_MS=60000
# Xaliye6 application confirmation SMS (backend only)
SMS_ENABLED=false
SMS_PROVIDER=XALIYE6
SMS_API_URL=https://api.xaliye6.online/sendSMS
SMS_BRAND_NAME=Jamhuuriya University
SMS_REQUEST_TIMEOUT=15
SMS_MAX_RETRIES=3
SMS_DEFAULT_COUNTRY_CODE=252
SMS_SCHEDULER_MS=30000
SMS_BATCH_SIZE=50
SMS_BATCH_DELAY_SECONDS=2
SMS_TEST_PHONE=+252618833500
# Contact-message email replies (Gmail requires an App Password)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=15000
EMAIL_FROM=
EMAIL_FROM_NAME=Jamhuriya University
EMAIL_REPLY_TO=
